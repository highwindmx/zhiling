# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-uv/
.venv*/
venv/
*venv/

# ---------- 体积大 / 可重建的产物 ----------
# 帧序列由 build/build_frames.py 从 assets/ 里的源视频重建，不进仓库
deskpet-python/frames_idle/
deskpet-python/frames_action/
**/frames_*/

# Tauri 运行期素材目录（由 prepare_assets.py --assets 从 deskpet-python 拷过来）
deskpet-tauri/assets/
# Tauri 前端暂存目录（编译期输入，产物 32KB）
deskpet-tauri/frontend-dist/

# 工坊/素材包：帧与 mp4 走 Release 附件，不进 git（manifest 与 state-map/clips.json 例外）
# 旧结构 packs/<packId>/frames_<clipId>/ 与新结构 packs/<packId>/frames/<clipId>/ 都忽略
packs/*/frames/
packs/**/frames/
packs/*/source/
packs/**/source/
packs/*/.backup/
packs/**/.backup/
# 迁移前的旧清单备份（meta.json / 旧 manifest）
packs/.legacy/
packs/*/posters/

# 原始素材（用户手上的绿幕 mp4，来自即梦/海螺）
material/
# 第三方只读目录（dsh-deskpet-bridge，不入库也不改）
dsh-deskpet-bridge/

# build 目录下的抽帧中间产物（保留 .py 脚本）
deskpet-python/build/f24/
deskpet-python/build/action_raw/
deskpet-python/build/raw_frames/
deskpet-python/build/raw_*/
deskpet-python/build/probe_*/
deskpet-python/build/_accept_out/
deskpet-python/build/_probe2/
deskpet-python/build/test_frames/
deskpet-python/build/webp_test/
deskpet-python/build/judge/
deskpet-python/build/*.png
deskpet-python/build/*.log
deskpet-python/build/*.txt
deskpet-python/debug.log
deskpet-python/*.log
harness_bridge_test.mjs

# ---------- 根目录的原始素材（成品与素材已放到 deskpet-python/assets 与 docs） ----------
/*.mp4
/*.gif
/*.jpg

# ---------- 系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
