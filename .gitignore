# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*venv/

# ---------- 体积大 / 可重建的产物 ----------
# 帧序列由 build/build_frames.py 从 assets/ 里的源视频重建，不进仓库
deskpet-mini/frames_idle/
deskpet-mini/frames_action/
**/frames_*/

# Tauri 运行期素材目录（由 prepare_assets.py --assets 从 deskpet-mini 拷过来）
deskpet-tauri/assets/
# Tauri 前端暂存目录（编译期输入，产物 32KB）
deskpet-tauri/frontend-dist/

# 工坊/素材包：帧与 mp4 走 Release 附件，不进 git（manifest 与 state-map 例外）
packs/*/frames/
packs/*/source/
packs/*/.backup/
packs/*/posters/

# build 目录下的抽帧中间产物（保留 .py 脚本）
deskpet-mini/build/f24/
deskpet-mini/build/action_raw/
deskpet-mini/build/raw_frames/
deskpet-mini/build/raw_*/
deskpet-mini/build/test_frames/
deskpet-mini/build/webp_test/
deskpet-mini/build/judge/
deskpet-mini/build/*.png
deskpet-mini/build/*.log

# ---------- 根目录的原始素材（成品与素材已放到 deskpet-mini/assets 与 docs） ----------
/*.mp4
/*.gif
/*.jpg

# ---------- 系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
