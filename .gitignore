# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-uv/
.venv*/
venv/
*venv/

# ---------- 体积大 / 可重建的产物 ----------
# 帧序列由 build/build_frames.py 从 assets/ 里的源视频重建，不进仓库
deskpet-python/frames_idle/
deskpet-python/frames_action/
**/frames_*/

# Tauri 运行期素材目录（由 prepare_assets.py --assets 从 deskpet-python 拷过来）
deskpet-tauri/assets/
# Tauri 前端暂存目录（编译期输入，产物 32KB）
deskpet-tauri/frontend-dist/

# 工坊/素材包：帧与 mp4 走 Release 附件，不进 git（manifest 与 state-map/clips.json 例外）
# packs 已迁到 deskpet-python/packs/；下面同时保留旧的仓库根 packs/ 规则，防止历史目录残留
deskpet-python/packs/*/frames/
deskpet-python/packs/**/frames/
deskpet-python/packs/*/source/
deskpet-python/packs/**/source/
deskpet-python/packs/*/.backup/
deskpet-python/packs/**/.backup/
deskpet-python/packs/.legacy/
deskpet-python/packs/*/posters/
packs/*/frames/
packs/**/frames/
packs/*/source/
packs/**/source/
packs/*/.backup/
packs/**/.backup/
# 迁移前的旧清单备份（meta.json / 旧 manifest）
packs/.legacy/
deskpet-python/packs/.legacy/
packs/*/posters/

# 文档只在本地维护，不推到 GitHub（docs/ 下含设计文档与测试过程截图）
docs/
deskpet-python/docs/
deskpet-tauri/docs/

# 测试/验证截图一律不入库、不上传：截图放本地 build/screenshots/（任意层级同名目录都忽略）
**/build/screenshots/
screenshots/
*_screenshot.png

# 原始素材（用户手上的绿幕 mp4，来自即梦/海螺）
material/
# 第三方只读目录（dsh-deskpet-bridge，不入库也不改）
dsh-deskpet-bridge/

# build 目录：只忽略可重建的中间产物（cache/），脚本（build/tools/）照常跟踪
# cache/ 可整目录删除，下一次从 material/ 的源视频重新抽帧即可
deskpet-python/build/cache/
deskpet-python/debug.log
deskpet-python/*.log
# harness 已迁至 deskpet-python/build/tools/harness_bridge_test.mjs，纳入版本控制
# 用户偏好（默认尺寸等）由「设置…」写入，因机器而异，不入库
deskpet-python/config.json
deskpet-python/config.json.migrated

# ---------- 根目录的原始素材（成品与素材已放到 deskpet-python/assets 与 docs） ----------
/*.mp4
/*.gif
/*.jpg

# ---------- 系统 / 编辑器 ----------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# 清理隔离区：候选文件待用户复核后再处置，不入库
archive/quarantine-*/

# 一次性验证脚本 / 中间截图的工作区（随时可整目录删除）
_scratch/

# ---------- 本地工具 / 安装残留（不入库） ----------
# 自动化浏览器/agent 工具留下的缓存目录
.playwright-cli/
.workbuddy/
# pip 嵌套解包 / 构建残留（sandbox 下常无法删除）
pytmp/
# 根目录 build/（playwright 等工具产出，非本仓库构建目录）
/build/
# 一次性打包产物
packs.zip
# 临时编辑备份
*.bak_ui
*.bak
*~

# 运行日志 / 测试缓存残留（sandbox 下常无法删除）
**/debug.log
pytest-cache-files-*/
.pytest_cache/
